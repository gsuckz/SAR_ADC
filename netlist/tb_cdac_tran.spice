.subckt cdac xd in d[9] d[7] d[0] d[11] d[3] d[4] d[2] d[1] d[8] d[6] d[5] d[10] gnd vdd  cu=5u
*.ipin d[0]
*.ipin d[1]
*.ipin d[2]
*.ipin d[3]
*.ipin d[4]
*.ipin d[5]
*.ipin d[6]
*.ipin d[7]
*.ipin d[8]
*.ipin d[9]
*.ipin d[10]
*.ipin d[11]
*.iopin vdd
*.iopin gnd
*.iopin in
*.iopin xd
x1 in vdd gnd d[0] cdac_line CW={cu} CL={cu} n=1
x2 in vdd gnd d[1] cdac_line CW={2*cu} CL={2*cu} n=1
x3 in vdd gnd d[2] cdac_line CW={4*cu} CL={4*cu} n=2
x4 in vdd gnd d[3] cdac_line CW={8*cu} CL={8*cu} n=4
